# Copy to .env before `docker compose up`.

# Required: at least 32 random characters. Generate with: openssl rand -base64 48
JWT_KEY=change-me-to-a-long-random-string-of-at-least-32-chars

# Public URL of the web app (CORS + links inside emails)
FRONTEND_URL=http://localhost:8080

# Insert demo business, staff, services and bookings on first start
SEED_ENABLED=true

# Stripe (test mode). Leave the keys empty to use simulated payments.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
PAYMENTS_ALLOW_DEMO=true
