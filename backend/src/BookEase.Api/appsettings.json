{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": { "path": "logs/bookease-.log", "rollingInterval": "Day", "retainedFileCountLimit": 14 }
      }
    ]
  },
  "ConnectionStrings": { "Default": "Data Source=bookease.db;Default Timeout=30" },
  "Database": { "Provider": "Sqlite", "MigrateOnStartup": true },
  "Seed": { "Enabled": false },
  "Jwt": { "Key": "", "Issuer": "BookEase", "Audience": "BookEase.Client", "AccessTokenMinutes": 15, "RefreshTokenDays": 14 },
  "Stripe": { "SecretKey": "", "PublishableKey": "", "WebhookSecret": "" },
  "Payments": { "AllowDemo": false },
  "Smtp": { "Host": "localhost", "Port": 1025, "UseTls": false, "Username": "", "Password": "", "FromAddress": "no-reply@bookease.local", "FromName": "BookEase" },
  "Booking": { "HoldMinutes": 10, "ReminderHoursBefore": 24 },
  "App": { "FrontendUrl": "http://localhost:5173" },
  "Cors": { "AllowedOrigins": [ "http://localhost:5173" ] },
  "RateLimiting": { "AuthPermitLimit": 20 },
  "BackgroundJobs": { "Enabled": true },
  "Swagger": { "Enabled": false },
  "AllowedHosts": "*"
}
